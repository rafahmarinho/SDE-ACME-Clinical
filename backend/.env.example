# ACME Clinical API - example configuration. Copy to .env (local) or set in Vercel > Settings > Environment Variables.
# Never commit real values. Generate each 32-byte key with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"

ENVIRONMENT=development                     # development | test | production (production enforces https + TLS to the DB)
APP_URL=http://localhost:5173               # web app origin, used for password-reset / invitation links
ALLOWED_ORIGINS=http://localhost:5173       # comma-separated CORS allowlist (exact origins)

# Supabase pooler connection as the least-privilege role created by the migration (not "postgres").
# Transaction pooler, port 6543. Username format: acme_api.<project-ref>
DATABASE_URL=postgresql://acme_api.your-project-ref:CHANGE_ME@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Optional: path to the Supabase CA certificate to enable sslmode=verify-full
DB_SSL_ROOT_CERT=
DB_POOL_MAX_SIZE=4

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx      # publishable (or legacy anon) key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx   # secret (or legacy service_role) key - server only!
# Only for projects still using the legacy HS256 JWT secret. Leave empty to verify tokens with the JWKS (recommended).
SUPABASE_JWT_SECRET=

DATA_ENCRYPTION_KEY=base64-32-bytes        # AES-256-GCM key for clinical notes
AUDIT_HMAC_KEY=base64-32-bytes             # HMAC key chaining the audit log
PSEUDONYM_KEY=base64-32-bytes              # HMAC key for de-identified reports
DEVICE_MASTER_KEY=base64-32-bytes          # derives per-monitor signing secrets for /devices/ingest

# Security policy (defaults shown)
REQUIRE_ADMIN_MFA=true
IDLE_TIMEOUT_MINUTES=15
ABSOLUTE_TIMEOUT_HOURS=12
MAX_CONCURRENT_SESSIONS=3
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
LOGIN_IP_LIMIT_PER_5MIN=100
EMERGENCY_ACCESS_MINUTES=30
DATA_RETENTION_DAYS=7

# Used only by scripts/seed.py (demo accounts). Must satisfy the password policy.
DEMO_PASSWORD=
DEMO_EMAIL_DOMAIN=acme-clinical.example
